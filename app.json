{
  "expo": {
    "name": "课程表",
    "slug": "course-table-app",
    "version": "1.0.7",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "coursetableapp",
    "userInterfaceStyle": "automatic",
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.fksguh.coursetableapp",
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "VIBRATE"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/icon.png",
          "imageWidth": 76
        }
      ],
      "expo-document-picker",
      "expo-image-picker",
      "./plugins/withNoBackup",
      [
        "@bittingz/expo-widgets",
        {
          "android": {
            "src": "./widgets",
            "distPlaceholder": "com.fksguh.coursetableapp.widget",
            "widgets": [
              {
                "name": "TimetableWidgetProvider",
                "resourceName": "@xml/widget_timetable_info"
              }
            ]
          }
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "7f3e7f03-1d6c-4d2d-8a9e-e660b375e400"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/7f3e7f03-1d6c-4d2d-8a9e-e660b375e400"
    },
    "ios": {}
  }
}
